JSON;

	/** @var array|null Lazily decoded immutable operation metadata. */
	private static ?array $operations = null;

	/** Return all documented operation IDs in alphabetical order. */
	public static function all(): array
	{
		return array_keys(self::catalog());
	}

	/**
	 * Return a documented operation's request and response contract.
	 *
	 * @throws \InvalidArgumentException for an unknown operation ID.
	 */
	public static function get(string $operationId): array
	{
		$operations = self::catalog();

		if (!isset($operations[$operationId]))
		{
			throw new \InvalidArgumentException('Unknown Gitea operation: ' . $operationId);
		}

		return $operations[$operationId];
	}

	/** Decode once; returned arrays use PHP copy-on-write semantics. */
	private static function catalog(): array
	{
		if (self::$operations === null)
		{
			self::$operations = json_decode(self::JSON, true, 512, JSON_THROW_ON_ERROR);
		}

		return self::$operations;
	}
