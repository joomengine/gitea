	/**
	 * The Http class
	 *
	 * @var    Http
	 * @since 3.2.0
	 */
	protected Http $http;

	/**
	 * The Uri class
	 *
	 * @var    Uri
	 * @since 3.2.0
	 */
	protected Uri $uri;

	/**
	 * The Response class
	 *
	 * @var    Response
	 * @since 3.2.0
	 */
	protected Response $response;

	/**
	 * The Url string
	 *
	 * @var    string|null
	 * @since 3.2.0
	 */
	protected ?string $url = null;

	/**
	 * The token string
	 *
	 * @var    string|null
	 * @since 3.2.0
	 */
	protected ?string $token = null;

	/**
	 * Whether a token was backed up, including an anonymous (null) token.
	 *
	 * @var    bool
	 * @since  1.1.0
	 */
	protected bool $tokenBackedUp = false;

	/**
	 * Constructor.
	 *
	 * @param   Http        $http       The http class.
	 * @param   Uri         $uri        The uri class.
	 * @param   Response    $response   The response class.
	 *
	 * @since   3.2.0
	 **/
	public function __construct(Http $http, Uri $uri, Response $response)
	{
		$this->http = $http;
		$this->uri = $uri;
		$this->response = $response;
	}

	/**
	 * Load/Reload API.
	 *
	 * @param   string|null     $url          The url.
	 * @param   token|null     $token      The token.
	 * @param   bool             $backup   The backup swapping switch.
	 *
	 * @return  void
	 * @since   3.2.0
	 **/
	public function load_(?string $url = null, ?string $token = null, bool $backup = true): void
	{
		// we keep the old values
		// so we can reset after our call
		// for the rest of the container
		if ($backup)
		{
			if ($url !== null)
			{
				$this->url = $this->uri->getUrl();
			}

			if ($token !== null)
			{
				$this->token = $this->http->getToken();
				$this->tokenBackedUp = true;
			}
		}

		if ($url !== null)
		{
			$this->uri->setUrl($url);
		}

		if ($token !== null)
		{
			$this->http->setToken($token);
		}
	}

	/**
	 * Restore the backed-up URL and token, including anonymous access.
	 *
	 * @return  void
	 * @since   3.2.0
	 **/
	public function reset_(): void
	{
		if ($this->url !== null)
		{
			$this->uri->setUrl($this->url);
			$this->url = null;
		}

		if ($this->tokenBackedUp)
		{
			$this->http->setToken($this->token ?? '');
			$this->token = null;
			$this->tokenBackedUp = false;
		}
	}

	/**
	 * Get the API url
	 *
	 * @return  string
	 * @since   3.2.0
	 **/
	public function api()
	{
		return $this->uri->api();
	}

	/**
	 * Encode one API path parameter, including reserved characters and slashes.
	 *
	 * @param   string  $value  The unencoded parameter value.
	 *
	 * @return  string
	 * @since   1.1.0
	 */
	protected function segment(string $value): string
	{
		if ($value === '.' || $value === '..')
		{
			throw new \InvalidArgumentException('Gitea path parameters cannot contain standalone dot segments.');
		}

		return rawurlencode($value);
	}

	/**
	 * Encode a repository file path while preserving directory separators.
	 *
	 * @param   string  $value  The unencoded repository path.
	 *
	 * @return  string
	 * @since   1.1.0
	 */
	protected function path(string $value): string
	{
		return implode('/', array_map([$this, 'segment'], explode('/', $value)));
	}

	/**
	 * Encode a JSON request, rejecting invalid input before any network request.
	 *
	 * @param   mixed  $data  The request payload.
	 *
	 * @return  string
	 * @since   1.1.0
	 * @throws  \JsonException
	 */
	protected function encode($data): string
	{
		return json_encode($data, JSON_THROW_ON_ERROR);
	}