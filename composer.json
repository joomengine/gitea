{
    "name": "joomengine/gitea-power-checks",
    "description": "Development dependencies for testing the Gitea Super Powers; not a JCB installer.",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "php": "^8.1",
        "joomla/http": "^2.0 || ^3.0 || ^4.0",
        "joomla/uri": "^2.0 || ^3.0 || ^4.0",
        "joomla/di": "^2.0 || ^3.0 || ^4.0",
        "joomla/registry": "^2.0 || ^3.0 || ^4.0"
    },
    "scripts": {
        "test": "php tests/run.php",
        "check": ["php tests/structure.php", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
